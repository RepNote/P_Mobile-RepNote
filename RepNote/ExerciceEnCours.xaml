<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepNote.ExerciceEnCours"
             Title="ExerciceEnCours">
    <Grid RowDefinitions="Auto, *, Auto" Padding="25, 10, 25, 20">

        <!-- En-tête : logo, titre de la page et chronomètre -->
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,15">
            <Label Text="RepNote" 
                   TextColor="White" 
                   HorizontalOptions="Center" 
                   FontSize="13" 
                   FontAttributes="Bold" />

            <Label Text="Séance en cours" 
                   TextColor="White" 
                   FontSize="30" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"/>

            <Label Text="Temps écoulé : 00:00" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Zone scrollable : modification exercice + ajout série + liste -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15">

                <!-- Bloc pour modifier le nom de l'exercice en cours -->
                <Label Text="Modifier l'exercice" TextColor="#8E8E8E" FontSize="15" />
                <Frame BackgroundColor="#2D2D2D" CornerRadius="20" HasShadow="False" Padding="20, 15">
                    <VerticalStackLayout Spacing="5">
                        <Entry Text="" TextColor="White" FontSize="16" BackgroundColor="Transparent" />
                        <BoxView HeightRequest="1" Color="#444444" />
                        <Button Text="Modifier" TextColor="#3498DB" BackgroundColor="Transparent" HorizontalOptions="Start" FontAttributes="Bold" Padding="0" HeightRequest="35"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Formulaire d'ajout d'une série (reps + poids) -->
                <Label Text="Ajouter une série" TextColor="#8E8E8E" FontSize="15" />
                <Frame BackgroundColor="#2D2D2D" CornerRadius="20" HasShadow="False" Padding="20, 15">
                    <VerticalStackLayout Spacing="10">
                        <Entry Placeholder="Répétitions" PlaceholderColor="#666666" TextColor="White" Keyboard="Numeric" BackgroundColor="Transparent" />
                        <BoxView HeightRequest="1" Color="#444444" />

                        <Entry Placeholder="Poids" PlaceholderColor="#666666" TextColor="White" Keyboard="Numeric" BackgroundColor="Transparent" />
                        <BoxView HeightRequest="1" Color="#444444" />

                        <Button Text="Ajouter" TextColor="#3498DB" BackgroundColor="Transparent" HorizontalOptions="Start" FontAttributes="Bold" Padding="0" HeightRequest="35" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Liste des séries ajoutées pendant la séance -->
                <Label Text="Série ajoutées" TextColor="#8E8E8E" FontSize="15" Margin="0,10,0,0" />
                <CollectionView x:Name="SeriesList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- Carte série : numéro + reps/poids + boutons modifier/supprimer -->
                            <Frame BackgroundColor="#2D2D2D" CornerRadius="15" Margin="0,0,0,10" Padding="15" HasShadow="False">
                                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto, Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Série 1" TextColor="White" FontAttributes="Bold" FontSize="16" />

                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="20" Margin="0,5,0,0">
                                        <Label Text="Reps : 11" TextColor="#CCCCCC" FontSize="14" />
                                        <Label Text="Poids : 24" TextColor="#CCCCCC" FontSize="14" />
                                    </HorizontalStackLayout>

                                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="✎" TextColor="#3498DB" BackgroundColor="Transparent" FontSize="20" WidthRequest="40" />
                                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Text="🗑" TextColor="#3498DB" BackgroundColor="Transparent" FontSize="20" WidthRequest="40" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2"
                Text="Terminer la séance"
                BackgroundColor="#EF4444"
                TextColor="White"
                HeightRequest="55"
                CornerRadius="25"
                FontSize="18"
                FontAttributes="Bold"
                VerticalOptions="End" />

    </Grid>
</ContentPage>