<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepNote.PlanifSerie"
             BackgroundColor="#0D0D0D">

    <Grid RowDefinitions="Auto, *, Auto" Padding="25, 10, 25, 20">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,25">
            <Label Text="RepNote" 
                   TextColor="White" 
                   HorizontalOptions="Center" 
                   FontSize="13" 
                   FontAttributes="Bold" />

            <Label Text="Plannification" 
                   TextColor="White" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   Margin="0,20,0,0"/>
        </VerticalStackLayout>

        <!-- Formulaire et Liste -->
        <VerticalStackLayout Grid.Row="1" Spacing="15">
            <Label Text="Ajouter une série" 
                   TextColor="#8E8E8E" 
                   FontSize="16" />

            <Frame BackgroundColor="#1A1A1A" 
                   CornerRadius="20" 
                   HasShadow="False" 
                   Padding="20, 25">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Nom" 
                           TextColor="#4A4A4A" 
                           FontSize="14" 
                           FontAttributes="Bold" />

                    <!-- Entry avec x:Name pour y accéder en C# -->
                    <Entry x:Name="SeriesEntry"
                           Placeholder=""
                           TextColor="White"
                           BackgroundColor="Transparent"
                           FontSize="16"
                           HeightRequest="40"
                           Margin="0,-5,0,0" />

                    <BoxView HeightRequest="1" 
                             Color="#333333" 
                             HorizontalOptions="Fill" 
                             Margin="0,0,0,15" />

                    <!-- Bouton avec événement Clicked -->
                    <Button Text="Ajouter" 
                            Clicked="OnAddSeriesClicked"
                            TextColor="#3498DB" 
                            BackgroundColor="Transparent"
                            HorizontalOptions="Start"
                            FontSize="17"
                            FontAttributes="Bold"
                            Padding="0"
                            HeightRequest="30" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Série ajoutées" 
                   TextColor="#8E8E8E" 
                   FontSize="16" 
                   Margin="0,15,0,0" />

            <!-- Liste dynamique des séries -->
            <CollectionView x:Name="SeriesList" Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#1A1A1A" 
                               CornerRadius="15" 
                               Margin="0,0,0,10" 
                               Padding="15,10"
                               HasShadow="False">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <!-- Le texte de la série -->
                                <Label Grid.Column="0" 
                                       Text="{Binding .}" 
                                       TextColor="White" 
                                       VerticalOptions="Center" 
                                       FontSize="16"
                                       FontAttributes="Bold" />

                                <!-- Icônes d'action (Edit et Delete) -->
                                <Button Grid.Column="1" 
                                        Text="✎" 
                                        FontSize="20"
                                        TextColor="#3498DB" 
                                        BackgroundColor="Transparent"
                                        WidthRequest="45"/>

                                <Button Grid.Column="2" 
                                        Text="🗑" 
                                        FontSize="20"
                                        TextColor="#3498DB" 
                                        BackgroundColor="Transparent"
                                        WidthRequest="45"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

        <!-- Bouton de pied de page -->
        <Button Grid.Row="2"
                Text="Terminer la séance"
                BackgroundColor="#EF4444"
                TextColor="White"
                HeightRequest="55"
                CornerRadius="15"
                FontSize="16"
                FontAttributes="Bold"
                VerticalOptions="End" 
                Clicked="onButtonClicked" />

    </Grid>
</ContentPage>