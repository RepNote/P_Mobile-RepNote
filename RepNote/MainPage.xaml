<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepNote.MainPage"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             BackgroundColor="Black">

    <VerticalStackLayout Padding="10" VerticalOptions="Fill">

        <controls:Calendar
            Day="14"
            Month="6"
            Year="2026"
            HeightRequest="450"
            HorizontalOptions="Fill"
            BackgroundColor="#121212"
            MonthLabelColor="White"
            YearLabelColor="White"
            DaysTitleColor="Orange"
            SelectedDayBackgroundColor="Blue"
            SelectedDayTextColor="White"
            DeselectedDayTextColor="White"
            OtherMonthDayColor="Gray" />

    </VerticalStackLayout>

</ContentPage>