<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepNote.MainPage"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="0">

        <!-- Calendrier fixe en haut -->
        <controls:Calendar
        Grid.Row="0"
        Events="{Binding Events}"
        SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
        HeightRequest="380"
        HorizontalOptions="Fill"
        BackgroundColor="Transparent"
        MonthLabelColor="White"
        YearLabelColor="White"
        DaysTitleColor="White"
        DaysTitleWeekendColor="Aqua"
        SelectedDayBackgroundColor="RoyalBlue"
        SelectedDayTextColor="White"
        DeselectedDayTextColor="White"
        OtherMonthDayColor="Gray"
        TodayOutlineColor="Transparent"
        TodayFillColor="LightBlue"
        EventIndicatorColor="RoyalBlue"
        EventIndicatorSelectedColor="Aquamarine"
        EventIndicatorTextColor="White"
        EventIndicatorSelectedTextColor="White"
        ArrowsBackgroundColor="Transparent"
        ArrowsColor="White"
        ArrowsFontSize="25"
        ShowYearPicker="False"
        FirstDayOfWeek="Monday"
        EventsScrollViewVisible="False">
            <controls:Calendar.EventTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="15,10" Spacing="2">
                        <Label Text="{Binding Name}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding Description}" TextColor="Gray" FontSize="14" />
                        <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />
                    </VerticalStackLayout>
                </DataTemplate>
            </controls:Calendar.EventTemplate>
        </controls:Calendar>

        <!-- Liste scrollable des événements du jour sélectionné -->
        <ScrollView Grid.Row="1" Padding="15,0">
            <VerticalStackLayout Spacing="0">

                <!-- Durée totale -->
                <Label Text="{Binding DurationText}"
                       TextColor="#1DB954"
                       FontSize="14"
                       FontAttributes="Bold"
                       Margin="0,12,0,4"
                       IsVisible="{Binding IsDurationVisible}" />

                <!-- Section : Exercices planifiés -->
                <Label Text="Exercices planifiés"
                       TextColor="#888888"
                       FontSize="13"
                       FontAttributes="Bold"
                       Margin="0,12,0,4"
                       IsVisible="{Binding IsPlannedSectionVisible}" />
                <CollectionView ItemsSource="{Binding PlannedDayEvents}"
                                IsVisible="{Binding IsPlannedSectionVisible}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Padding="0,10" Spacing="2">
                                <Label Text="{Binding Name}"
                                       TextColor="White"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Description}"
                                       TextColor="Gray"
                                       FontSize="14" />
                                <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Section : Exercices ajoutés en séance -->
                <Label Text="Exercices ajoutés en séance"
                       TextColor="#888888"
                       FontSize="13"
                       FontAttributes="Bold"
                       Margin="0,12,0,4"
                       IsVisible="{Binding IsAddedSectionVisible}" />
                <CollectionView ItemsSource="{Binding AddedDayEvents}"
                                IsVisible="{Binding IsAddedSectionVisible}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Padding="0,10" Spacing="2">
                                <Label Text="{Binding Name}"
                                       TextColor="White"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Description}"
                                       TextColor="Gray"
                                       FontSize="14" />
                                <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Boutons en bas -->
        <Grid Grid.Row="2"
          ColumnDefinitions="*, *"
          ColumnSpacing="15"
          Padding="20,10,20,30"
          BackgroundColor="Transparent">
            <Button Grid.Column="0"
                Text="Commencer"
                BackgroundColor="#1DB954"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="55"
                Clicked="onClickButton1" />
            <Button Grid.Column="1"
                Text="Plannifier"
                BackgroundColor="#E67E22"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="55"
                Clicked="onClickButton2" />
        </Grid>
    </Grid>
</ContentPage>