<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepNote.MainPage"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="10" VerticalOptions="Fill">

        <controls:Calendar
            Events="{Binding Events}"
            Day="14"
            Month="4"
            Year="2026"
            HeightRequest="450"
            HorizontalOptions="Fill"
            BackgroundColor="Transparent"
            MonthLabelColor="White"
            YearLabelColor="White"
            DaysTitleColor="White"
            DaysTitleWeekendColor="Aqua"
            SelectedDayBackgroundColor="RoyalBlue"
            SelectedDayTextColor="White"
            DeselectedDayTextColor="White"
            OtherMonthDayColor="Gray"
            TodayOutlineColor="Transparent"
            TodayFillColor="LightBlue"
            EventIndicatorColor="RoyalBlue"
            EventIndicatorSelectedColor="Aquamarine"
            ArrowsBackgroundColor="Transparent"
            ArrowsColor="White"
            ArrowsFontSize="25"
            ShowYearPicker="False"
            FirstDayOfWeek="Monday"
            />

    </VerticalStackLayout>

</ContentPage>