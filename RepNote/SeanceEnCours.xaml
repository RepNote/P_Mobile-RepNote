<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RepNote.SeanceEnCours"
             Title=""
             BackgroundColor="#1C1C1C">

    <Shell.TitleView>
        <Label Text="RepNote"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
    </Shell.TitleView>

    <Grid RowDefinitions="*, Auto">

        <!-- Scrollable content -->
        <ScrollView Grid.Row="0" Padding="0,0,0,16">
            <VerticalStackLayout Spacing="0" Padding="20,20,20,0">

                <!-- Header: Séance en cours + Timer -->
                <VerticalStackLayout Spacing="4" Margin="0,0,0,28">
                    <Label Text="Séance en cours"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Start" />
                    <Label x:Name="TimerLabel"
                           Text="Temps écoulé : 00:00"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Start" />
                </VerticalStackLayout>

                <!-- Section: Ajouter un exercice -->
                <Label Text="Ajouter un exercice"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,0,0,10" />

                <Border BackgroundColor="#2A2A2A"
                        StrokeThickness="0"
                        Margin="0,0,0,24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Padding="16,14,16,14" Spacing="8">

                        <!-- Nom Entry -->
                        <Entry x:Name="NomExerciceEntry"
                               Placeholder="Nom"
                               PlaceholderColor="#888888"
                               TextColor="White"
                               FontSize="15"
                               BackgroundColor="Transparent">
                            <Entry.Behaviors>
                                <!-- Entry underline via custom renderer or use BoxView below -->
                            </Entry.Behaviors>
                        </Entry>

                        <!-- Underline -->
                        <BoxView HeightRequest="1"
                                 BackgroundColor="#555555"
                                 Margin="0,-4,0,4" />

                        <!-- Ajouter button (text link style) -->
                        <Label Text="Ajouter"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#2196F3"
                               HorizontalOptions="Start">
                            <Label.GestureRecognizers>
                                <!-- <TapGestureRecognizer Tapped="OnAjouterExerciceTapped" /> -->
                            </Label.GestureRecognizers>
                        </Label>

                    </VerticalStackLayout>
                </Border>

                <!-- Section: Exercice planifié -->
                <Label Text="Exercice planifié"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,0,0,10" />


            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom button: Terminer la séance -->
        <Border Grid.Row="1"
                Margin="20,10,20,30"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>
            <Button Text="Terminer la séance"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#E53935"
                    HeightRequest="54"
                    CornerRadius="30"
                    Clicked="onButtonClicked" />
        </Border>

    </Grid>

</ContentPage>
